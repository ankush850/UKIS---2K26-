{
  "landing": "<!-- Landing Page -->\n    <div id=\"landing-page\" class=\"landing-page\">\n        <video autoplay muted loop playsinline class=\"landing-video-bg\">\n            <source src=\"/static/landingpage.mp4\" type=\"video/mp4\">\n        </video>\n        <div class=\"landing-ambient-bg\"></div>\n        <div class=\"landing-content\">\n            <div class=\"landing-badges\">\n                <span class=\"l-badge\"><span class=\"badge-dot gold\"></span> Copernicus CDSE Linked</span>\n                <span class=\"l-badge\"><span class=\"badge-dot purple\"></span> Blockchain Verified (Polygon Amoy)</span>\n                <span class=\"l-badge\"><span class=\"badge-dot blue\"></span> Hallucination-Aware USP</span>\n            </div>\n            \n            <h1 class=\"landing-title\">NETRA :<br> <span class=\"gold-text\">Sentinel-2</span><br><span class=\"blue-text\">Super-Resolution</span></h1>\n            <p class=\"landing-subtitle\">Neural Enhancement for Terrain & Resolution Amplification.<br>Delivering 16x pixel density with verifiable, hallucination-aware uncertainty.</p>\n            \n            <div class=\"landing-cards\">\n                <div class=\"l-card\">\n                    <div class=\"l-card-icon gold-text\">16x</div>\n                    <div class=\"l-card-text\">Resolution Gain</div>\n                    <div class=\"l-card-svg gold-text\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"></polygon><polyline points=\"2 12 12 17 22 12\"></polyline><polyline points=\"2 17 12 22 22 17\"></polyline></svg></div>\n                </div>\n                <div class=\"l-card\">\n                    <div class=\"l-card-icon blue-text\">MC</div>\n                    <div class=\"l-card-text\">Monte-Carlo<br>Uncertainty Scoring</div>\n                    <div class=\"l-card-svg blue-text\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"></line></svg></div>\n                </div>\n                <div class=\"l-card\">\n                    <div class=\"l-card-icon blue-text\">AI</div>\n                    <div class=\"l-card-text\">Automatic<br>Infrastructure Detection</div>\n                    <div class=\"l-card-svg blue-text\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\" ry=\"2\"></rect><rect x=\"9\" y=\"9\" width=\"6\" height=\"6\"></rect><line x1=\"9\" y1=\"1\" x2=\"9\" y2=\"4\"></line><line x1=\"15\" y1=\"1\" x2=\"15\" y2=\"4\"></line><line x1=\"9\" y1=\"20\" x2=\"9\" y2=\"23\"></line><line x1=\"15\" y1=\"20\" x2=\"15\" y2=\"23\"></line><line x1=\"20\" y1=\"9\" x2=\"23\" y2=\"9\"></line><line x1=\"20\" y1=\"14\" x2=\"23\" y2=\"14\"></line><line x1=\"1\" y1=\"9\" x2=\"4\" y2=\"9\"></line><line x1=\"1\" y1=\"14\" x2=\"4\" y2=\"14\"></line></svg></div>\n                </div>\n                <div class=\"l-card\">\n                    <div class=\"l-card-icon blue-text\">GIS</div>\n                    <div class=\"l-card-text\">GeoJSON Export with<br>Confidence Metrics</div>\n                    <div class=\"l-card-svg blue-text\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg></div>\n                </div>\n            </div>\n\n            <button id=\"btn-start-analysis\" class=\"btn-start-analysis\">\n                Start Analysis &rarr;\n            </button>\n\n            <div class=\"landing-footer\">\n                <div class=\"footer-line\"></div>\n                <span>HIGHER RESOLUTION. A CLEARER TOMORROW.</span>\n            </div>\n        </div>\n    </div>\n\n    <!-- Dashboard Container -->",
  "header_actions": "<div class=\"header-actions\">\n            <div class=\"system-status\">\n                <span class=\"status-indicator active\"></span>\n                <span class=\"status-label\">Copernicus CDSE Linked</span>\n            </div>\n</div>",
  "aoi_presets": "<p class=\"panel-desc\">Select a preset Sentinel-2 target scene or draw on the interactive map below.</p>\n                <div class=\"presets-container\" id=\"presets-list\">\n                    <!-- Presets injected by JS -->\n                </div>\n\n                <div class=\"map-wrapper\">\n                    <div id=\"aoi-map\"></div>\n                    <div class=\"map-overlay-badge\" id=\"aoi-coords-badge\">Lat: 30.575 | Lon: 75.330</div>\n                </div>",
  "aoi_coords": "<!-- Unified Aerospace Coordinates Nav Bar -->\n                <div class=\"coord-search-bar\" id=\"coords-entry-box\">\n                    <div class=\"coord-input-wrap\">\n                        <span class=\"coord-prefix\">LAT</span>\n                        <input type=\"text\" inputmode=\"decimal\" id=\"input-custom-lat\" class=\"coord-text-input\" value=\"30.5750\" placeholder=\"30.5750\" title=\"Latitude (-90 to 90)\">\n                    </div>\n                    <div class=\"coord-separator\">|</div>\n                    <div class=\"coord-input-wrap\">\n                        <span class=\"coord-prefix\">LON</span>\n                        <input type=\"text\" inputmode=\"decimal\" id=\"input-custom-lon\" class=\"coord-text-input\" value=\"75.3300\" placeholder=\"75.3300\" title=\"Longitude (-180 to 180)\">\n                    </div>\n                    <button id=\"btn-goto-coords\" type=\"button\" class=\"btn-coord-jump\" title=\"Jump to coordinates &amp; fetch Sentinel-2 tile\">\n                        <span>Jump</span>\n                        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                            <polyline points=\"9 18 15 12 9 6\"></polyline>\n                        </svg>\n                    </button>\n                </div>\n\n                <button id=\"btn-draw-rect\" type=\"button\" class=\"btn btn-sm btn-outline btn-block-mt\">\n                    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" />\n                        <path d=\"M9 3v18\" />\n                        <path d=\"M15 3v18\" />\n                    </svg>\n                    Draw Free Bounding Box on Map\n                </button>\n            </div>\n\n            <!-- Pipeline Parameters -->\n            <div class=\"panel-card\">\n                <h3 class=\"panel-title\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\" />\n                        <line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\" />\n                        <line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\" />\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\" />\n                        <line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\" />\n                        <line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\" />\n                        <line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\" />\n                        <line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\" />\n                        <line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\" />\n                    </svg>\n                    Model &amp; Inference Engine\n                </h3>\n                <div class=\"form-group\">\n                    <label>Architecture</label>\n                    <select id=\"select-model\" class=\"custom-select\">\n                        <option value=\"hat\" selected>HAT (Hybrid Attention Transformer \u2014 Sharpest Edges)</option>\n                        <option value=\"ldsr_s2\" title=\"ESA Latent Diffusion Model. Produces sharper output with high textural detail, but requires closer scrutiny of the uncertainty/confidence score as diffusion models can generate convincing but fabricated structures.\">LDSR-S2 (Diffusion \u2014 High Detail)</option>\n                        <option value=\"srmnet\">SRM-Net (Residual Attention + MC-Dropout)</option>\n                        <option value=\"evoland_carn\">CARN (Cascading Residual Network \u2014 Conservative)</option>\n                    </select>\n                    <div id=\"ldsr-diffusion-notice\" class=\"diffusion-warning-box hidden\" style=\"margin-top: 0.45rem; padding: 0.45rem 0.65rem; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 6px; font-size: 0.73rem; color: #fde68a;\">\n                        <span style=\"margin-right: 4px;\">\u26a0\ufe0f</span>\n                        <strong>Diffusion Detail Advisory:</strong> LDSR-S2 produces high textural sharpness. Always inspect the Confidence HUD and uncertainty map to guard against generative hallucination.\n                    </div>\n                </div>\n\n                <div class=\"form-group edge-enhancement-box\" style=\"border: 1px solid rgba(139, 92, 246, 0.4); background: rgba(139, 92, 246, 0.08);\">\n                    <div>\n                        <label class=\"edge-enhancement-title\" style=\"color: #c084fc;\">Stage 2: Real-ESRGAN Sharpening (outscale=1)</label>\n                        <span class=\"edge-enhancement-desc\">RealESRGAN_x4plus (RRDBNet) preview pass \u2022 Metrics stay on pure HAT</span>\n                    </div>\n                    <input type=\"checkbox\" id=\"check-realesrgan-sharpen\" class=\"checkbox-cyan\">\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Target Resolution / Scale</label>\n                    <select id=\"select-scale\" class=\"custom-select\">\n                        <option value=\"4\" selected>4x Upscaling (10.0m \u2192 2.5m GSD - Sub-4m Target)</option>\n                        <option value=\"2\">2x Upscaling (10.0m \u2192 5.0m GSD)</option>\n                    </select>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Acquisition Mode</label>\n                    <div class=\"mode-toggles acquisition-mode-toggles\">\n                        <button type=\"button\" class=\"tab-btn tab-btn-compact active\" id=\"btn-mode-single\">Single\n                            Pass</button>\n                        <button type=\"button\" class=\"tab-btn tab-btn-compact\" id=\"btn-mode-multi\">Multi-Temporal (3-Pass\n                            Fusion)</button>\n                    </div>\n                </div>\n\n                <div class=\"form-group\">\n                    <div class=\"label-with-val\">\n                        <label>MC-Dropout Passes (Uncertainty)</label>\n                        <span class=\"range-val\" id=\"val-mc-samples\">8 passes</span>\n                    </div>\n                    <input type=\"range\" id=\"slider-mc-samples\" min=\"4\" max=\"16\" step=\"2\" value=\"8\"\n                        class=\"custom-slider\">\n                </div>\n\n                <div class=\"custom-upload-box\">\n                    <input type=\"file\" id=\"file-upload\" accept=\"image/*,.tif\" hidden>\n                    <button type=\"button\" class=\"btn btn-outline\" id=\"btn-trigger-upload\">\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                            stroke-width=\"2\">\n                            <path d=\"M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4\" />\n                            <polyline points=\"17 8 12 3 7 8\" />\n                            <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\" />\n                        </svg>\n                        Upload Custom GeoTIFF / Tile\n                    </button>\n                </div>\n            \n        ",
  "model_panel": "<div class=\"panel-card\">\n                <h3 class=\"panel-title\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z\" />\n                        <circle cx=\"12\" cy=\"10\" r=\"3\" />\n                    </svg>\n                    Area of Interest (AOI)\n                </h3>\n                <p class=\"panel-desc\">Select a preset Sentinel-2 target scene or draw on the interactive map below.</p>\n                <div class=\"presets-container\" id=\"presets-list\">\n                    <!-- Presets injected by JS -->\n                </div>\n\n                <div class=\"map-wrapper\">\n                    <div id=\"aoi-map\"></div>\n                    <div class=\"map-overlay-badge\" id=\"aoi-coords-badge\">Lat: 30.575 | Lon: 75.330</div>\n                </div>\n\n                <!-- Unified Aerospace Coordinates Nav Bar -->\n                <div class=\"coord-search-bar\" id=\"coords-entry-box\">\n                    <div class=\"coord-input-wrap\">\n                        <span class=\"coord-prefix\">LAT</span>\n                        <input type=\"text\" inputmode=\"decimal\" id=\"input-custom-lat\" class=\"coord-text-input\" value=\"30.5750\" placeholder=\"30.5750\" title=\"Latitude (-90 to 90)\">\n                    </div>\n                    <div class=\"coord-separator\">|</div>\n                    <div class=\"coord-input-wrap\">\n                        <span class=\"coord-prefix\">LON</span>\n                        <input type=\"text\" inputmode=\"decimal\" id=\"input-custom-lon\" class=\"coord-text-input\" value=\"75.3300\" placeholder=\"75.3300\" title=\"Longitude (-180 to 180)\">\n                    </div>\n                    <button id=\"btn-goto-coords\" type=\"button\" class=\"btn-coord-jump\" title=\"Jump to coordinates &amp; fetch Sentinel-2 tile\">\n                        <span>Jump</span>\n                        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                            <polyline points=\"9 18 15 12 9 6\"></polyline>\n                        </svg>\n                    </button>\n                </div>\n\n                <button id=\"btn-draw-rect\" type=\"button\" class=\"btn btn-sm btn-outline btn-block-mt\">\n                    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" />\n                        <path d=\"M9 3v18\" />\n                        <path d=\"M15 3v18\" />\n                    </svg>\n                    Draw Free Bounding Box on Map\n                </button>\n            </div>\n\n            <!-- Pipeline Parameters -->\n            <div class=\"panel-card\">\n                <h3 class=\"panel-title\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\" />\n                        <line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\" />\n                        <line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\" />\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\" />\n                        <line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\" />\n                        <line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\" />\n                        <line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\" />\n                        <line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\" />\n                        <line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\" />\n                    </svg>\n                    Model &amp; Inference Engine\n                </h3>\n                <div class=\"form-group\">\n                    <label>Architecture</label>\n                    <select id=\"select-model\" class=\"custom-select\">\n                        <option value=\"hat\" selected>HAT (Hybrid Attention Transformer \u2014 Sharpest Edges)</option>\n                        <option value=\"ldsr_s2\" title=\"ESA Latent Diffusion Model. Produces sharper output with high textural detail, but requires closer scrutiny of the uncertainty/confidence score as diffusion models can generate convincing but fabricated structures.\">LDSR-S2 (Diffusion \u2014 High Detail)</option>\n                        <option value=\"srmnet\">SRM-Net (Residual Attention + MC-Dropout)</option>\n                        <option value=\"evoland_carn\">CARN (Cascading Residual Network \u2014 Conservative)</option>\n                    </select>\n                    <div id=\"ldsr-diffusion-notice\" class=\"diffusion-warning-box hidden\" style=\"margin-top: 0.45rem; padding: 0.45rem 0.65rem; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 6px; font-size: 0.73rem; color: #fde68a;\">\n                        <span style=\"margin-right: 4px;\">\u26a0\ufe0f</span>\n                        <strong>Diffusion Detail Advisory:</strong> LDSR-S2 produces high textural sharpness. Always inspect the Confidence HUD and uncertainty map to guard against generative hallucination.\n                    </div>\n                </div>\n</div>",
  "toolbar": "<div class=\"viewer-toolbar\">\n                <div class=\"mode-toggles\">\n                    <button type=\"button\" class=\"tab-btn active\" id=\"tab-split\">Split Slider View</button>\n                    <button type=\"button\" class=\"tab-btn\" id=\"tab-side\">Side-by-Side View</button>\n                </div>\n\n                <!-- Multi-Band Spectral Index / Visualization Dropdown -->\n                <div class=\"vis-mode-control\" id=\"vis-mode-control\">\n                    <span class=\"vis-mode-label\">\n                        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <polygon points=\"12 2 2 7 12 12 22 7 12 2\"/>\n                            <polyline points=\"2 17 12 22 22 17\"/>\n                            <polyline points=\"2 12 12 17 22 12\"/>\n                        </svg>\n                        Spectral Mode:\n                    </span>\n                    <select id=\"select-vis-mode\" class=\"select-vis-mode\" title=\"Switch Multi-Band Spectral Index / Visualization (spyndex)\">\n                        <option value=\"true_color\" selected>\ud83c\udf3f True Color (Natural RGB)</option>\n                        <option value=\"false_color_ir\">\ud83d\udd34 False Color IR (NIR-Red-Green)</option>\n                        <option value=\"ndvi\">\ud83c\udf31 NDVI (Vegetation Health)</option>\n                        <option value=\"ndwi\">\ud83d\udca7 NDWI (Water Bodies)</option>\n                        <option value=\"ndbi\">\ud83c\udfe2 NDBI (Built-up / Urban)</option>\n                        <option value=\"nbr\">\ud83d\udd25 NBR (Burn / Disaster)</option>\n                    </select>\n                </div>\n\n                <!-- OpenSeadragon Deep-Zoom Controls -->\n                <div class=\"osd-zoom-controls\">\n                    <span class=\"osd-zoom-label\">Zoom:</span>\n                    <button type=\"button\" id=\"btn-zoom-in\" class=\"btn-zoom\" title=\"Zoom In (+)\">\u2795</button>\n                    <button type=\"button\" id=\"btn-zoom-out\" class=\"btn-zoom\" title=\"Zoom Out (-)\">\u2796</button>\n                    <button type=\"button\" id=\"btn-zoom-reset\" class=\"btn-zoom\" title=\"Reset Zoom (Fit)\">1:1</button>\n                    <span id=\"zoom-level-badge\" class=\"zoom-level-badge\">1.0x</span>\n                </div>\n\n                <div class=\"usp-toolbar-controls\">\n                    <div class=\"toggle-pill\" id=\"toggle-confidence-pill\">\n                        <span class=\"pill-dot\"></span>\n                        <span class=\"pill-text\">USP Confidence Heatmap</span>\n                    </div>\n                    <div class=\"opacity-control\" id=\"confidence-opacity-wrapper\">\n                        <span>Opacity</span>\n                        <input type=\"range\" id=\"slider-confidence-opacity\" min=\"0.1\" max=\"1.0\" step=\"0.05\" value=\"0.75\"\n                            class=\"mini-slider\">\n                    </div>\n\n                    <!-- Infrastructure Detection Toggle Pill -->\n                    <div class=\"toggle-pill toggle-pill-infra\" id=\"toggle-infra-pill\"\n                        title=\"Live AI Infrastructure Detection: Buildings &amp; Roads (SamGeo)\">\n                        <span class=\"pill-dot pill-dot-purple\"></span>\n                        <span class=\"pill-text\">Buildings &amp; Roads</span>\n                    </div>\n                    <div class=\"opacity-control\" id=\"infra-opacity-wrapper\">\n                        <span>Opacity</span>\n                        <input type=\"range\" id=\"slider-infra-opacity\" min=\"0.1\" max=\"1.0\" step=\"0.05\" value=\"0.85\"\n                            class=\"mini-slider\">\n                    </div>\n\n                    <!-- Cloud Mask Occlusion Toggle Pill -->\n                    <div class=\"toggle-pill toggle-pill-cloud\" id=\"toggle-cloud-pill\"\n                        title=\"Cloud Mask: Optical Occlusion &amp; Uncertainty Boundaries\">\n                        <span class=\"pill-dot pill-dot-cloud\"></span>\n                        <span class=\"pill-text\">Cloud Mask (Occluded)</span>\n                    </div>\n                    <div class=\"opacity-control\" id=\"cloud-opacity-wrapper\">\n                        <span>Opacity</span>\n                        <input type=\"range\" id=\"slider-cloud-opacity\" min=\"0.1\" max=\"1.0\" step=\"0.05\" value=\"0.80\"\n                            class=\"mini-slider\">\n                    </div>\n\n                    <!-- ISRO Bhuvan OGC WMS Reference Toggle Pill -->\n                    <div class=\"toggle-pill toggle-pill-bhuvan\" id=\"toggle-bhuvan-pill\"\n                        title=\"ISRO Bhuvan National Geoportal Reference (OGC WMS: GANGA_LULC / LULC_BUILTUP)\">\n                        <span class=\"pill-dot\" style=\"background: #f97316; box-shadow: 0 0 8px #f97316;\"></span>\n                        <span class=\"pill-text\" style=\"color: #fdba74;\">ISRO Bhuvan</span>\n                    </div>\n                    <div class=\"opacity-control\" id=\"bhuvan-opacity-wrapper\">\n                        <span>Opacity</span>\n                        <input type=\"range\" id=\"slider-bhuvan-opacity\" min=\"0.1\" max=\"1.0\" step=\"0.05\" value=\"0.80\"\n                            class=\"mini-slider\">\n                    </div>\n                </div>\n\n                <div class=\"export-actions\">\n                    <button type=\"button\" id=\"btn-download-sr\" class=\"btn btn-sm btn-outline\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                            stroke-width=\"2\">\n                            <path d=\"M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4\" />\n                            <polyline points=\"7 10 12 15 17 10\" />\n                            <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                        </svg>\n                        Export SR (2.5m)\n                    </button>\n                    <button type=\"button\" id=\"btn-download-conf\" class=\"btn btn-sm btn-outline\">\n                        Export Confidence Map\n                    </button>\n                    <button type=\"button\" id=\"btn-download-geojson\" class=\"btn btn-sm btn-outline btn-geojson-export\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                            stroke-width=\"2\">\n                            <path d=\"M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4\" />\n                            <polyline points=\"7 10 12 15 17 10\" />\n                            <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" />\n                        </svg>\n                        Export GeoJSON\n                    </button>\n                </div>\n            </div>\n\n            <!-- High Cloud Cover",
  "canvas": "<!-- Comparison Canvas Container with Synchronized OpenSeadragon Viewports -->\n            <div class=\"canvas-viewport\" id=\"canvas-viewport\">\n                <!-- Split-Slider View with Synchronized OpenSeadragon Viewports -->\n                <div class=\"split-slider-container\" id=\"slider-container\">\n                    <!-- Base LR OpenSeadragon Viewport (Left) -->\n                    <div class=\"osd-wrapper osd-lr-wrapper\" id=\"osd-lr-wrapper\">\n                        <div id=\"osd-lr\" class=\"osd-viewport\"></div>\n                        <div class=\"img-tag tag-lr\">Input: Sentinel-2 L2A (10m)</div>\n                    </div>\n\n                    <!-- Super Resolved OpenSeadragon Viewport (Right / Interactive Clipped) -->\n                    <div class=\"osd-wrapper osd-sr-wrapper\" id=\"sr-wrapper\">\n                        <div id=\"osd-sr\" class=\"osd-viewport\"></div>\n                        <div class=\"img-tag tag-sr\" id=\"tag-sr\">Output: HAT (2.5m)</div>\n                    </div>\n\n                    <!-- Interactive Divider Bar -->\n                    <div class=\"slider-handle\" id=\"slider-handle\">\n                        <div class=\"handle-line\"></div>\n                        <div class=\"handle-grip\">\n                            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                                stroke-width=\"2.5\">\n                                <polyline points=\"15 18 9 12 15 6\" />\n                            </svg>\n                            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                                stroke-width=\"2.5\">\n                                <polyline points=\"9 18 15 12 9 6\" />\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n</div>",
  "viewer_footer": "<div class=\"viewer-footer\">\n                <!-- Spectral Index / Mode Legend -->\n                <div class=\"spectral-legend\" id=\"spectral-legend\">\n                    <div class=\"spectral-legend-header\">\n                        <span class=\"spectral-legend-title\" id=\"spectral-legend-title\">\ud83c\udf3f True Color</span>\n                        <span class=\"spectral-legend-stats\" id=\"spectral-legend-stats\">Natural Sentinel-2 Reflectance</span>\n                    </div>\n                    <div class=\"spectral-legend-bar-container\" id=\"spectral-legend-bar-container\" style=\"display: none;\">\n                        <div class=\"spectral-legend-bar\" id=\"spectral-legend-bar\"></div>\n                        <div class=\"spectral-legend-ticks\" id=\"spectral-legend-ticks\">\n                            <span id=\"spectral-tick-min\">-0.2</span>\n                            <span id=\"spectral-tick-mid\">0.3</span>\n                            <span id=\"spectral-tick-max\">+0.85</span>\n                        </div>\n                    </div>\n                    <div class=\"spectral-chips-container\" id=\"spectral-chips-container\" style=\"display: none;\"></div>\n                </div>\n\n                <div class=\"confidence-legend\">\n                    <span class=\"legend-label\">Hallucination Risk / Confidence Scale:</span>\n                    <div class=\"legend-bar\"></div>\n                    <div class=\"legend-ticks\">\n                        <span>0% (Hallucination Risk)</span>\n                        <span>50% (Inferred)</span>\n                        <span>100% (Observed Ground Truth)</span>\n                        <span class=\"legend-cloud-tick\">\u25a6 Hatched Slate: Cloud Occluded (0%)</span>\n                    </div>\n                </div>\n                <div class=\"infra-legend\" id=\"infra-legend\">\n                    <span class=\"infra-legend-title infra-legend-heading\">Layers:</span>\n                    <span class=\"infra-item infra-item-purple\"><span class=\"infra-dot infra-dot-purple\"></span>\n                        Building Footprints</span>\n                    <span class=\"infra-item infra-item-cyan\"><span class=\"infra-dot infra-dot-cyan\"></span>\n                        Road Corridors</span>\n                </div>\n                <div class=\"inspector-badge\">\n                    <span id=\"inspector-coords\">Resolution Gain: 30.0m \u2192 2.5m (16x pixel density)</span>\n                    <span id=\"inspector-dims\" class=\"inspector-dims-text\">LR: 128\u00d7128 px \u2192 SR: 512\u00d7512 px (Genuinely 4x\n                        array expansion)</span>\n                </div>\n            </div>\n        ",
  "usp": "<div class=\"panel-card usp-card\">\n                <div class=\"panel-card-header\">\n                    <h3 class=\"panel-title\">Hallucination &amp; Uncertainty</h3>\n                    <span class=\"card-badge\">THE USP</span>\n                </div>\n                <p class=\"panel-desc\">Scientific trust verification via ESA opensr-test &amp; Monte-Carlo variance.</p>\n\n                <div class=\"metric-grid\">\n                    <div class=\"metric-tile highlight\">\n                        <div class=\"metric-val\" id=\"metric-confidence\">--%</div>\n                        <div class=\"metric-lbl\">Avg Confidence Score</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-uncertainty\">--</div>\n                        <div class=\"metric-lbl\">MC-Dropout Variance</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-sam\">--\u00b0</div>\n                        <div class=\"metric-lbl\">Spectral Angle (SAM)</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-cycle\">--</div>\n                        <div class=\"metric-lbl\">Cycle Consistency MAE</div>\n                    </div>\n                </div>\n\n                <div class=\"callout-box\">\n                    <strong>Why this matters:</strong> Judges and decision makers can verify whether fine boundaries are\n                    physically observed by Sentinel-2 or synthesized by the neural generator.\n                </div>\n            </div>\n\n            <!-- Paired Reference",
  "val_paired": "<div class=\"panel-card\" id=\"panel-validation-paired\">\n                <div class=\"panel-card-header\">\n                    <h3 class=\"panel-title\">Validation vs HR Reference</h3>\n                    <span class=\"card-badge card-badge-cyan\">PAIRED GROUND TRUTH</span>\n                </div>\n                <p class=\"panel-desc panel-desc-secondary\">\n                    Full-reference pixel and structural fidelity benchmarks evaluated against paired SPOT 6/7 1.5m\n                    satellite optical ground truth.\n                </p>\n                <div class=\"metric-grid\" id=\"grid-validation-metrics\">\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-psnr\">-- dB</div>\n                        <div class=\"metric-lbl\">PSNR (vs HR Reference)</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-ssim\">--</div>\n                        <div class=\"metric-lbl\">SSIM Structure Index</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-ergas\">--</div>\n                        <div class=\"metric-lbl\">ERGAS Synthesis Error</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val\" id=\"metric-runtime\">-- ms</div>\n                        <div class=\"metric-lbl\">Inference Latency</div>\n                    </div>\n                </div>\n                <div class=\"coreg-status-banner\" id=\"coreg-status-banner\" style=\"margin-top: 10px; padding: 8px 12px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 6px; font-size: 0.78rem; display: flex; justify-content: space-between; align-items: center;\">\n                    <div id=\"coreg-shift-status\" style=\"color: #38bdf8; font-family: monospace;\">AROSICS Alignment: Ready</div>\n                    <div id=\"metric-computed-at\" style=\"color: #94a3b8; font-family: monospace;\">Execution: Ready</div>\n                </div>\n            </div>",
  "val_nr": "<div class=\"panel-card panel-card-nr\" id=\"panel-validation-nr\">\n                <div class=\"panel-card-header\">\n                    <h3 class=\"panel-title panel-title-purple\">No-Reference Quality Assessment</h3>\n                    <span class=\"card-badge card-badge-purple\">NO-REFERENCE IQA</span>\n                </div>\n\n                <div id=\"validation-no-ref-banner\" class=\"validation-nr-banner\">\n                    <div class=\"banner-heading-purple\">\n                        <span class=\"banner-icon-lg\">\u26a0\ufe0f</span> Unpaired Scene Notification\n                    </div>\n                    No ground truth reference available for this AOI \u2014 validation metrics require a paired\n                    high-resolution reference tile. Activating Blind/No-Reference Image Quality Assessment (pyiqa NIQE\n                    &amp; BRISQUE) + opensr-test trust metrics.\n                </div>\n\n                <div class=\"metric-grid\" id=\"grid-nr-metrics\">\n                    <div class=\"metric-tile highlight metric-tile-purple\">\n                        <div class=\"metric-val metric-val-purple\" id=\"metric-nr-niqe\">--</div>\n                        <div class=\"metric-lbl\">NIQE Score (pyiqa)</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val metric-val-sky\" id=\"metric-nr-brisque\">--</div>\n                        <div class=\"metric-lbl\">BRISQUE Score (pyiqa)</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val metric-val-emerald\" id=\"metric-nr-confidence\">--%</div>\n                        <div class=\"metric-lbl\">Confidence Trust</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val metric-val-yellow\" id=\"metric-nr-cycle\">--</div>\n                        <div class=\"metric-lbl\">Cycle Consistency MAE</div>\n                    </div>\n                </div>\n\n                <div class=\"callout-box callout-box-purple\">\n                    <strong>Reference-Free Verification:</strong> Evaluates natural scene statistics (NSS) directly on\n                    SR output via <code>pyiqa</code> (IQA-PyTorch) &amp; <code>opensr-test</code>.\n                </div>\n            </div>",
  "infra": "<div class=\"panel-card panel-card-amber\" id=\"panel-infrastructure\">\n                <div class=\"panel-card-header\">\n                    <h3 class=\"panel-title panel-title-amber\">Detected Infrastructure</h3>\n                    <span class=\"card-badge card-badge-cyan\">MULTI-CLASS EXTRACTION</span>\n                </div>\n                <p class=\"panel-desc\">Automatic live AI extraction of building footprints &amp; road networks on &lt;4m SRM output.</p>\n\n                <div class=\"metric-grid\">\n                    <div class=\"metric-tile highlight metric-tile-purple\">\n                        <div class=\"metric-val metric-val-purple\" id=\"metric-buildings\">--</div>\n                        <div class=\"metric-lbl\">Building Footprints</div>\n                    </div>\n                    <div class=\"metric-tile highlight\">\n                        <div class=\"metric-val metric-val-cyan\" id=\"metric-roads\">-- km</div>\n                        <div class=\"metric-lbl\">Road Corridors</div>\n                    </div>\n                    <div class=\"metric-tile\">\n                        <div class=\"metric-val metric-val-emerald\" id=\"metric-infra-conf\">--%</div>\n                        <div class=\"metric-lbl\">Detection Confidence</div>\n                    </div>\n                </div>\n\n                <div class=\"callout-box callout-box-purple\" style=\"margin-top: 10px;\">\n                    <strong>GIS Vector Export:</strong> Full vector topology exported as GeoJSON with per-feature\n                    confidence metrics for GIS analysis.\n                </div>\n            </div>",
  "pipeline": "<footer class=\"site-footer\" id=\"site-footer\" aria-label=\"Pipeline Verification and Provenance Telemetry\">\n        <div class=\"footer-card\">\n            <div class=\"footer-header\">\n                <div class=\"footer-title-group\">\n                    <h3 class=\"footer-title\">Pipeline Verification</h3>\n                    <span class=\"footer-subtitle\">Live inference telemetry, Monte-Carlo uncertainty, and paired satellite provenance</span>\n                </div>\n                <span class=\"card-badge card-badge-cyan\">LIVE PROVENANCE</span>\n            </div>\n            <div class=\"verif-grid\">\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Active Checkpoint</div>\n                    <div id=\"verif-checkpoint\" class=\"verif-code-white\">srmnet_x4_sentinel2.pt (4x / 2.5m GSD)</div>\n                </div>\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Dropout Mode (Inference)</div>\n                    <div id=\"verif-dropout\" class=\"verif-code-cyan\">force_dropout=True (BN frozen, 8 passes)</div>\n                </div>\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Raw Per-Pixel Variance (Unrounded)</div>\n                    <div id=\"verif-variance\" class=\"verif-code-green\">min: 7.64e-09 | max: 3.54e-06 | mean: 6.98e-07</div>\n                </div>\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Array Dimensions (Genuine 4x Expansion)</div>\n                    <div id=\"verif-dimensions\" class=\"verif-code-yellow\">LR: 128\u00d7128 px \u2192 SR: 512\u00d7512 px (16x pixel density)</div>\n                </div>\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Stage 2 Preview Sharpening</div>\n                    <div id=\"verif-unsharp\" class=\"verif-code-blue\">Real-ESRGAN x4plus (outscale=1, tile=256)</div>\n                </div>\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Ground Truth HR Reference</div>\n                    <div id=\"verif-reference\" class=\"verif-code-slate\">data/reference_hr/punjab_agri_spot_1.5m.npy (SPOT 1.5m)</div>\n                </div>\n\n                <div class=\"verif-tile\">\n                    <div class=\"verif-item-title\">Temporal Fusion Mode</div>\n                    <div id=\"verif-temporal\" class=\"verif-code-cyan\">Single-Pass (Default)</div>\n                </div>\n                <div class=\"verif-tile verif-tile-purple\">\n                    <div class=\"verif-item-title\">Polygon Amoy Blockchain Provenance</div>\n                    <div id=\"verif-blockchain-status\" class=\"verif-code-purple\">v1 (Verified) \u2022 SHA-256 Anchored</div>\n                </div>\n            </div>\n\n            <!-- Footer Blockchain Action Bar -->\n            <div class=\"footer-blockchain-strip\">\n                <div class=\"bc-footer-left\">\n                    <span class=\"chain-dot-purple\"></span>\n                    <span class=\"bc-footer-text\"><strong>On-Chain Provenance Chain:</strong> Sub-11cm Geo-tagging (lat/lon &amp; bbox scaled 1e6) + SHA-256 linked to Polygon Amoy Testnet (Chain ID 80002)</span>\n                </div>\n                <button type=\"button\" class=\"btn btn-sm btn-blockchain\" id=\"btn-footer-open-blockchain\">\n                    Inspect Version History Chain (v1 \u2794 v2 \u2794 v3)\n                </button>\n            </div>\n        </div>\n    </footer>",
  "modals": "<!-- Blockchain Provenance & Version Chain Modal -->\n    <div class=\"modal-overlay hidden\" id=\"modal-blockchain\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-blockchain-title\">\n        <div class=\"modal-card\">\n            <div class=\"modal-header\">\n                <div class=\"modal-title-group\">\n                    <div class=\"modal-chain-tag\">\n                        <span class=\"chain-dot-purple\"></span>\n                        Polygon Amoy Testnet (Chain ID: 80002)\n                    </div>\n                    <h2 class=\"modal-title\" id=\"modal-blockchain-title\">NETRA Blockchain Provenance</h2>\n                    <p class=\"modal-subtitle\">Immutable on-chain Geo-Tagging &amp; Version History Chain per tile</p>\n                </div>\n                <button type=\"button\" class=\"btn-modal-close\" id=\"btn-close-blockchain-modal\" aria-label=\"Close modal\">&times;</button>\n            </div>\n\n            <!-- Active Tile Telemetry Bar -->\n            <div class=\"blockchain-telemetry-bar\">\n                <div class=\"bc-tele-item\">\n                    <span class=\"bc-tele-label\">Active Tile</span>\n                    <span class=\"bc-tele-val\" id=\"bc-tile-id\">punjab_agri</span>\n                </div>\n                <div class=\"bc-tele-item\">\n                    <span class=\"bc-tele-label\">On-Chain Version</span>\n                    <span class=\"bc-tele-val cyan\" id=\"bc-version-tag\">v1 (Verified)</span>\n                </div>\n                <div class=\"bc-tele-item\">\n                    <span class=\"bc-tele-label\">Centre Coordinates (Scaled 1e6)</span>\n                    <span class=\"bc-tele-val\" id=\"bc-coords\">31.1471\u00b0N, 75.3412\u00b0E</span>\n                </div>\n                <div class=\"bc-tele-item\">\n                    <span class=\"bc-tele-label\">SHA-256 Output Hash</span>\n                    <code class=\"bc-tele-code\" id=\"bc-hash\" title=\"Full SHA-256 Hash\">0x...</code>\n                </div>\n                <div class=\"bc-tele-item\">\n                    <span class=\"bc-tele-label\">Polygonscan</span>\n                    <a href=\"https://amoy.polygonscan.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bc-explorer-link\" id=\"bc-tx-link\">View Tx \u2197</a>\n                </div>\n            </div>\n\n            <!-- Tabs: Version History Chain & On-Chain File Verifier -->\n            <div class=\"bc-tab-bar\">\n                <button type=\"button\" class=\"bc-tab-btn active\" id=\"tab-bc-history\">Version History Chain</button>\n                <button type=\"button\" class=\"bc-tab-btn\" id=\"tab-bc-verify\">Verify File On-Chain</button>\n            </div>\n\n            <!-- Tab Content 1: Version History Chain Timeline -->\n            <div class=\"bc-tab-pane\" id=\"pane-bc-history\">\n                <div class=\"bc-timeline\" id=\"bc-timeline-list\">\n                    <!-- Populated dynamically by app.js -->\n                </div>\n            </div>\n\n            <!-- Tab Content 2: Verification Tool -->\n            <div class=\"bc-tab-pane hidden\" id=\"pane-bc-verify\">\n                <div class=\"bc-verify-box\">\n                    <p class=\"bc-verify-desc\">\n                        Select any local or exported GeoTIFF / PNG to verify its cryptographic hash against the latest Polygon Amoy on-chain record for this tile.\n                    </p>\n                    <div class=\"bc-upload-dropzone\" id=\"bc-verify-dropzone\">\n                        <input type=\"file\" id=\"input-verify-file\" class=\"bc-file-input\" accept=\".tif,.tiff,.png,.jpg\">\n                        <div class=\"dropzone-text\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n                                <polyline points=\"17 8 12 3 7 8\"></polyline>\n                                <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n                            </svg>\n                            <span>Choose or drag satellite file here to verify on-chain</span>\n                        </div>\n                    </div>\n                    <div id=\"bc-verify-result\" class=\"bc-verify-result hidden\"></div>\n                </div>\n            </div>\n\n            <div class=\"modal-footer\">\n                <div class=\"modal-contract-info\">\n                    <span>Contract: <code id=\"bc-contract-address\">TileProvenance.sol (Polygon Amoy)</code></span>\n                </div>\n                <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-done-blockchain\">Done</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Leaflet & Leaflet.draw JS -->\n    <script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js\"></script>\n    <!-- OpenSeadragon Deep-Zoom High-Resolution Viewer -->\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.1/openseadragon.min.js\"></script>\n    <script src=\"/static/app.js?v=20260911_v3\"></script>\n    </body>\n\n</html>"
}